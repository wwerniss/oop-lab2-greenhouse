<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:element name="Flower">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="Plant" type="PlantType" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:simpleType name="SoilType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="podzolic"/>
            <xs:enumeration value="ground"/>
            <xs:enumeration value="sod-podzolic"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MultiplyingType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="leaves"/>
            <xs:enumeration value="cuttings"/>
            <xs:enumeration value="seeds"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="SizeType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0.1"/>
            <xs:maxInclusive value="500"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TemperatureType">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="-30"/>
            <xs:maxInclusive value="60"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="WateringType">
        <xs:restriction base="xs:nonNegativeInteger">
            <xs:maxInclusive value="10000"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="SizeWithUnitType">
        <xs:simpleContent>
            <xs:extension base="SizeType">
                <xs:attribute name="unit" type="xs:string" use="required" fixed="cm"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>

    <xs:complexType name="VisualParametersType">
        <xs:sequence>
            <xs:element name="StemColor" type="xs:string"/>
            <xs:element name="LeafColor" type="xs:string"/>
            <xs:element name="AverageSizeCm" type="SizeWithUnitType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="GrowingTipsType">
        <xs:sequence>
            <xs:element name="TemperatureCelsius" type="TemperatureType"/>
            <xs:element name="LightLoving" type="xs:boolean"/>
            <xs:element name="WateringMlPerWeek" type="WateringType"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PlantType">
        <xs:sequence>
            <xs:element name="Name" type="xs:string"/>
            <xs:element name="Soil" type="SoilType"/>
            <xs:element name="Origin" type="xs:string"/>
            <xs:element name="VisualParameters" type="VisualParametersType"/>
            <xs:element name="GrowingTips" type="GrowingTipsType"/>
            <xs:element name="Multiplying" type="MultiplyingType"/>
        </xs:sequence>
        
        <xs:attribute name="id" type="xs:ID" use="required"/>
    </xs:complexType>
</xs:schema>
